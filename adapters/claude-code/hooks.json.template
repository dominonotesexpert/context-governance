{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schemas/hooks.json",
  "_comment": "Context Governance hooks for Claude Code. Copy to .claude/settings.local.json under 'hooks' key.",
  "_contract_version": "1",

  "hooks": {
    "PreToolUse": [
      {
        "_comment": "Runtime authority enforcement. Delegates to the declarative policy engine (docs/templates/governance/rules/authority.rule.yaml + context-class-tools.rule.yaml). Non-zero exit aborts the tool call and stderr is shown to the user.",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/adapters/claude-code/cc-authority-hook.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_comment": "Audit capture: log file modifications for governance trail. PDRs already written by PreToolUse; this captures only file-mutation outcomes.",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'mkdir -p .governance/audit && echo \"{\\\"timestamp\\\":\\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\",\\\"tool\\\":\\\"$CLAUDE_TOOL_NAME\\\",\\\"file\\\":\\\"$CLAUDE_TOOL_PARAM_file_path\\\"}\" >> .governance/audit/session.jsonl 2>/dev/null; exit 0'"
          }
        ]
      }
    ]
  }
}
